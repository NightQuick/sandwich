{
  "compilerOptions": {
    "types": ["vite/client"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@script/*": ["./src/script/*"],
      "@styles/*": ["./src/styles/*"],
      "@images/*": ["./public/i/*"],
      "@/*": ["./src/*"],
      "@constants": ["./src/constants.ts"],
      "@api": ["./src/api.ts"],
      "@callbacks": ["./src/callbacks.ts"],
      "@dp/*": ["./src/script/dataProcessing/*"],
      "@elements/*": ["./src/script/elements/*"],
      "@ui/*": ["./src/script/UI/*"],
      "@components/*": ["./src/components/*"],
      "@composables/*": ["./src/script/composables/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}